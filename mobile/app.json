{
  "expo": {
    "name": "Catalyst AI",
    "slug": "catalyst-ai-agent",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E3A5F"
      },
      "package": "com.catalystai.agent"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "aiseekho",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e69caf59-af1b-4faa-aada-987c423db29b"
      }
    },
    "owner": "hanzalah026"
  }
}
