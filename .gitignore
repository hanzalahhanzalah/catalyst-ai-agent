# .gitignore for Catalyst AI — AISeekho Agent

# ════════════════════════════════════════════════════════
# 🔐 SECRETS & API KEYS — NEVER COMMIT THESE
# ════════════════════════════════════════════════════════
.env
.env.*
*.env
!.env.example
!.env.sample

# Specific secret files
backend/.env
mobile/.env
secrets/
credentials/
*.pem
*.key
*.p12
*.p8
*.jks
*.mobileprovision
google-services.json
GoogleService-Info.plist
service_account.json
serviceAccountKey.json

# API key files
api_keys.txt
api_keys.json
keys.json
secrets.json
config.secret.*

