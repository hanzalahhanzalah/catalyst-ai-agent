# 🐍 Python
# ════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
build/
.eggs/
*.so

# Virtual environments
venv/
env/
.venv/
ENV/
.env.bak

